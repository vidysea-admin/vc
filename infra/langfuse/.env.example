# infra/langfuse/.env.example — committed. Copy to infra/langfuse/.env (gitignored, see
# infra/langfuse/.gitignore) and replace every CHANGE_ME before `docker compose up`.
#
# Generate strong secrets with (git-bash / WSL / any POSIX shell):
#   openssl rand -hex 32     -> ENCRYPTION_KEY (must be exactly 64 hex chars)
#   openssl rand -base64 32  -> SALT, NEXTAUTH_SECRET, REDIS_AUTH, POSTGRES_PASSWORD,
#                                CLICKHOUSE_PASSWORD, MINIO_ROOT_PASSWORD
#
# Never commit infra/langfuse/.env. Never point NEXTAUTH_URL / any of these at a Langfuse Cloud
# host — this stack is self-hosted only (D-004, standard rule 5 MUST c).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME

REDIS_AUTH=CHANGE_ME

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# Langfuse app secrets
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000

# Optional: auto-provision an org/project/user/API-key pair on first boot instead of doing it
# through the web UI. Leave blank to skip and provision by hand.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=vc-dev
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Once the project exists (auto-provisioned above, or created by hand in the UI), copy its keys
# here too — this is what packages/observability's loadTracingConfig() reads at app runtime.
# baseUrl MUST stay on our own infra (http://localhost:3000 in dev) and MUST NOT be any
# *.cloud.langfuse.com / hipaa.cloud.langfuse.com host.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=CHANGE_ME_pk-lf-...
LANGFUSE_SECRET_KEY=CHANGE_ME_sk-lf-...
