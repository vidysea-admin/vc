# Copy to .env (git-ignored) and fill in. Never commit values (contract B11).
GEMINI_API_KEY=
# Production Mongo server (IP-allowlisted). The engine uses ONLY the database "virtual_counsellor" (contract B12, qa/gates/mongo-host.md).
MONGODB_URL=
# Model provider seam (contract B6, packages/providers): "mock", "gemini", "litellm" or "rules".
# No default on purpose.
VC_LLM_PROVIDER=
# Model name for the chosen provider (required for gemini and litellm; a class name like
# "balanced" from D:/ai_os/litellm-config.yaml when VC_LLM_BASE_URL points at that gateway).
VC_LLM_MODEL=
# T-019: OpenAI-compatible gateway base URL for the litellm provider (required for litellm).
VC_LLM_BASE_URL=
# T-019: optional bearer key for the litellm provider's gateway (some local gateways need none).
VC_LLM_API_KEY=
# T-026: KnowledgeBase /ask API (contract B21 Knowledge clause, B2 citations). Base URL + Bearer
# key for the sibling D:/KnowledgeBase service's POST /ask. Optional -- unset, the university-kb
# MCP server registers no ask_knowledge_base tool and serves only its local Mongo courses tools.
VC_KB_BASE_URL=
VC_KB_API_KEY=
# T-027: HMAC-SHA256 secret for signing outbound webhooks (contract B21/B11). Never commit a value.
VC_WEBHOOK_SECRET=

# T-025 (B21 / D-021): the VC API's JWT verification and HTTP port. Names only; values live in .env.
# Issuer (required when the HTTP API runs) and optional audience the tokens must carry.
# B21: until the client backend supplies its own, the issuer is the placeholder umesh with a locally
# generated key pair (public key below; the private key never enters the repo). Switching to the real
# issuer later = new VC_JWT_ISSUER + VC_JWT_PUBLIC_KEY or VC_JWT_JWKS_URL, no code change.
VC_JWT_ISSUER=
VC_JWT_AUDIENCE=
# Allow-list; default RS256,ES256. "none" is never accepted. HS256 only alone, with VC_JWT_HS256_SECRET.
VC_JWT_ALGORITHMS=
# Exactly one key source: a PEM SPKI public key (one line, \n escaped), an https JWKS URL, or an HS256 secret (>= 32 bytes).
VC_JWT_PUBLIC_KEY=
VC_JWT_JWKS_URL=
VC_JWT_HS256_SECRET=
# exp/nbf clock skew in seconds (default 30, max 300).
VC_JWT_CLOCK_SKEW_SEC=
# HTTP port for startApi({ http }) (default 8080; binds 127.0.0.1 unless a host is passed).
VC_API_PORT=

# apps/web reference UI + evidence harness (ISS-075). Names only; all optional.
# Evidence mode for the checker's live-browser capture: mode, port and the unit slug being evidenced.
VC_EVIDENCE_MODE=
VC_EVIDENCE_PORT=
VC_EVIDENCE_UNIT=
# Override for the SKILL.md directory the runtime loads (default: the repo's skills dir).
VC_SKILLS_DIR=
# T-029 (B15 erasure approver workflow). Names only; values live in .env.
# HMAC-SHA256 key for the erasure audit pseudonym (>= 32 characters). Required for the erasure
# reconfirm/approve routes; missing = a config error (503), never a fallback to an unkeyed hash.
VC_AUDIT_HMAC_KEY=
# Where the approval request is addressed (written to the email_outbox collection only; nothing is sent).
# Required while VC_ERASURE_AUTO_DELETE is false.
VC_ERASURE_APPROVER_EMAIL=
# "true" skips the approver after the counsellor's double confirmation. Default false.
VC_ERASURE_AUTO_DELETE=
