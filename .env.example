# Copy to .env (git-ignored) and fill in. Never commit values (contract B11).
GEMINI_API_KEY=
# Production Mongo server (IP-allowlisted). The engine uses ONLY the database "virtual_counsellor" (contract B12, qa/gates/mongo-host.md).
MONGODB_URL=
# Model provider seam (contract B6, packages/providers): "mock", "gemini", "litellm" or "rules".
# No default on purpose.
VC_LLM_PROVIDER=
# Model name for the chosen provider (required for gemini and litellm; a class name like
# "balanced" from D:/ai_os/litellm-config.yaml when VC_LLM_BASE_URL points at that gateway).
VC_LLM_MODEL=
# T-019: OpenAI-compatible gateway base URL for the litellm provider (required for litellm).
VC_LLM_BASE_URL=
# T-019: optional bearer key for the litellm provider's gateway (some local gateways need none).
VC_LLM_API_KEY=
# T-026: KnowledgeBase /ask API (contract B21 Knowledge clause, B2 citations). Base URL + Bearer
# key for the sibling D:/KnowledgeBase service's POST /ask. Optional -- unset, the university-kb
# MCP server registers no ask_knowledge_base tool and serves only its local Mongo courses tools.
VC_KB_BASE_URL=
VC_KB_API_KEY=
# P1/U2 (spec A15c, gap G4): a SEPARATE search-only KnowledgeBase key (scopes search + sources, no ask, no
# sessions) for the anonymous student route. Never falls back to VC_KB_API_KEY. Unset = anonymous KB off.
VC_KB_ANON_API_KEY=
# T-027: HMAC-SHA256 secret for signing outbound webhooks (contract B21/B11). Never commit a value.
VC_WEBHOOK_SECRET=
# T-034: where the fact.approved / erasure.requested webhook outbox drains to (Pathlynks first,
# contract B21 Events). Optional -- unset, the API's emission hook is a no-op (nothing enqueued);
# the drain worker that reads VC_WEBHOOK_SECRET to actually POST these is a separate process, not
# started by this unit (no network send).
VC_WEBHOOK_DESTINATION_URL=

# T-025 (B21 / D-021): the VC API's JWT verification and HTTP port. Names only; values live in .env.
# Issuer (required when the HTTP API runs) and optional audience the tokens must carry.
# B21: until the client backend supplies its own, the issuer is the placeholder umesh with a locally
# generated key pair (public key below; the private key never enters the repo). Switching to the real
# issuer later = new VC_JWT_ISSUER + VC_JWT_PUBLIC_KEY or VC_JWT_JWKS_URL, no code change.
VC_JWT_ISSUER=
VC_JWT_AUDIENCE=
# Allow-list; default RS256,ES256. "none" is never accepted. HS256 only alone, with VC_JWT_HS256_SECRET.
VC_JWT_ALGORITHMS=
# Exactly one key source: a PEM SPKI public key (one line, \n escaped), an https JWKS URL, or an HS256 secret (>= 32 bytes).
VC_JWT_PUBLIC_KEY=
VC_JWT_JWKS_URL=
VC_JWT_HS256_SECRET=
# exp/nbf clock skew in seconds (default 30, max 300).
VC_JWT_CLOCK_SKEW_SEC=
# HTTP port for startApi({ http }) (default 8080; binds 127.0.0.1 unless a host is passed).
VC_API_PORT=

# apps/web reference UI + evidence harness (ISS-075). Names only; all optional.
# Evidence mode for the checker's live-browser capture: mode, port and the unit slug being evidenced.
VC_EVIDENCE_MODE=
VC_EVIDENCE_PORT=
VC_EVIDENCE_UNIT=
# Override for the SKILL.md directory the runtime loads (default: the repo's skills dir).
VC_SKILLS_DIR=
# T-029 (B15 erasure approver workflow). Names only; values live in .env.
# HMAC-SHA256 key for the erasure audit pseudonym (>= 32 characters). Required for the erasure
# reconfirm/approve routes; missing = a config error (503), never a fallback to an unkeyed hash.
VC_AUDIT_HMAC_KEY=
# Where the approval request is addressed (written to the email_outbox collection only; nothing is sent).
# Required while VC_ERASURE_AUTO_DELETE is false.
VC_ERASURE_APPROVER_EMAIL=
# "true" skips the approver after the counsellor's double confirmation. Default false.
VC_ERASURE_AUTO_DELETE=
# T-012 (B16): the async concern classifier (second safety layer). Names only; all optional.
# Model tier for the classifier, passed through the provider seam (default "flash-lite").
VC_CONCERN_MODEL=
# Per-call timeout in ms (default 8000). A timeout never blocks: a guard flag escalates on its own.
VC_CONCERN_TIMEOUT_MS=
# Sample rates for UNFLAGGED student turns, per script stratum (default latin=0.1,devanagari=0.25,other=0.25).
VC_CONCERN_SAMPLE_RATES=
# P1 LK1w (D-105): the Ollama text chain for the STUDENT surfaces only (chat turn, anonymous route). Names only; unset = those surfaces keep
# using the VC_LLM_* provider above. The scribe and the concern classifier never move to the chain until each passes its own eval (D-105 Q4).
# Comma-separated ollama:<model-id>, tried in this order, one pass, bounded by the product deadline.
#   DeepSeek first (the go-live default, D-108): VC_TEXT_CHAIN=ollama:deepseek-v4.1-flash,ollama:glm-5.3-flash
#   GLM first (config only):                     VC_TEXT_CHAIN=ollama:glm-5.3-flash,ollama:deepseek-v4.1-flash
# Which order is faster is decided by the LK9 first-token probe; flipping it is this one line, no code change.
VC_TEXT_CHAIN=
# Required when VC_TEXT_CHAIN is set. Never commit a value.
OLLAMA_API_KEY=
# Optional: per-hop timeout ms (default 8000), whole-chain deadline ms (default 12000), Ollama base URL.
VC_TEXT_CHAIN_HOP_TIMEOUT_MS=
VC_TEXT_CHAIN_DEADLINE_MS=
OLLAMA_BASE_URL=
# P1 LK7: REQUIRED when VC_TEXT_CHAIN is set (the chain does not start without it): the most the chain may spend per calendar month (UTC), in USD,
# as a plain positive number such as 50 or 12.5. A request that would pass it is refused and the student gets the usual "try again" reply. In-process
# only (a restart starts the month from zero). Go-live example (D-108): VC_CHAIN_MONTHLY_CAP_USD=50
# Alerts on the same engineering-alert mechanism as the failover alert: alert_chain_cap_80pct (once per month) and alert_chain_cap_exhausted
# (once per month); see docs/runbook-golive.md.
VC_CHAIN_MONTHLY_CAP_USD=
# P1 LK7: the LK5 model safety screen on the anonymous route. Default off (contract A15b / B24.6 vs D-105 is an open decision); exactly "true" turns it on.
# The authenticated chat screen is always on (opt out in code with chat.safetyScreen = false).
VC_ANONYMOUS_SAFETY_SCREEN=
# P1 LK4/LK7 (D-105 Q1): reply-language allow-list for authenticated chat, comma-separated (default en,hi,hi-Latn). English is always allowed.
VC_REPLY_LANGS=

# ============================================================================
# GO-LIVE LAUNCH BLOCK (golive-launcher; gate qa/gates/golive-launch.md, D-108). Placeholders only: the real values live in
# /etc/vc/vc.env on the server (systemd EnvironmentFile), never in git. A later line overrides an earlier empty one above.
# Launcher: `pnpm -C apps/api start` (apps/api/src/main.ts), behind nginx (infra/ubuntu/). It binds 127.0.0.1 only.
# ============================================================================
# Model provider: Ollama Cloud through the OpenAI-compatible litellm seam (DeepSeek first, D-108).
VC_LLM_PROVIDER=litellm
VC_LLM_BASE_URL=https://ollama.com/v1
# Same value as OLLAMA_API_KEY below. Never commit a value.
VC_LLM_API_KEY=<OLLAMA_API_KEY value>
VC_LLM_MODEL=deepseek-v4.1-flash
VC_CONCERN_MODEL=deepseek-v4.1-flash
# Student text chain (DeepSeek first) and its monthly spend cap in USD (the chain refuses to start without the cap).
VC_TEXT_CHAIN=ollama:deepseek-v4.1-flash,ollama:glm-5.3-flash
OLLAMA_API_KEY=<ollama cloud key>
VC_CHAIN_MONTHLY_CAP_USD=50
# KnowledgeBase (key values provided by Umesh in the server .env, gate Q4). The anonymous key is search-only and never falls back to VC_KB_API_KEY.
VC_KB_BASE_URL=<knowledgebase base url>
VC_KB_ANON_API_KEY=<search-only key>
# Needed only when VC_CHAT_ENABLED=true (authenticated chat; also needs the VC_STUDENT_JWT_* names documented in apps/api/src/auth.ts).
VC_KB_API_KEY=<chat key>
# Speakers file for the no-quote guard (JSON, SpeakersFileSchema). Unset = an empty list until the KnowledgeBase team supplies one (gate Q5).
VC_SPEAKERS_FILE=/etc/vc/speakers.json
# Port nginx proxies /v1/ to (127.0.0.1 only).
VC_API_PORT=8080
# Surfaces: the public anonymous text route (also needs the A20 go-live gate) and the authenticated chat. Exactly "true" turns one on; voice stays off (g-prod option c).
VC_ANONYMOUS_ENABLED=true
VC_CHAT_ENABLED=false
# The counsellor API's token verifier is still read by startApi: set VC_JWT_ISSUER and exactly one key source (see the T-025 block above).

# Per-partner API keys (D-111, pc-partner-keys). The pepper HMACs partner keys before they are stored; at least 32 characters, a secret, never commit a value, changing it invalidates every key.
VC_PARTNER_KEY_PEPPER=
# "true" makes the public chat route require a valid X-VC-Key (needs the pepper). Unset or false keeps keyless anonymous access.
VC_PARTNER_KEY_REQUIRED=
# pc-reserved-ids: tenant ids a partner id may never equal (comma or space separated), e.g. the `tenant` values your student JWTs carry and the sandbox tenant. Read by `partner add` and by the
# running server (a partner key whose id is listed is refused as an unknown key). Built in: sandbox/admin/system/root/default/internal, alone or followed by a separator and suffix (sandbox-1).
# EMPTY = built-ins and the repo's own tenants only: the real student-JWT tenants are then unprotected (startApi logs a warning, `partner add`/`partner list` warn on stderr). List them all, and run `partner list` before deploy.
VC_RESERVED_TENANT_IDS=
# pc-reserved-ids-2: partners whose own id is also a listed JWT tenant, as <partner>:<tenant> with both halves equal (e.g. pathlynks:pathlynks). Exempts that exact partner only; never a built-in name, a repo tenant or the sandbox tenant.
VC_PARTNER_OWN_TENANTS=

# vc-admin-control (VA1, S1-S3). Names only; values live in .env and are never committed.
# Master key for the AES-256-GCM secrets stored in Mongo (sources.setSecret): base64 of EXACTLY 32 random bytes. A key of any other length is refused at startup.
VC_ADMIN_MASTER_KEY=
# HS256 signing secret for the admin console JWT (>= 32 characters). A token without typ "vc-admin" is refused.
VC_ADMIN_JWT_SECRET=
# USD to INR rate used for cost per student on the dashboard (a number; the dashboard shows it against the INR 50 target).
VC_USD_INR_RATE=
# config/sources.json passwordRef / tokenRef names. The Pathlynks Postgres password is put here by Umesh himself (gate G1); a GitHub token is optional (public repos need none).
PATHLYNKS_DB_PASSWORD=
GITHUB_TOKEN=
# Web console -> API: the base URL the Next.js admin proxy calls (server side only; the browser never sees it).
VC_ADMIN_API_URL=
# G1 (answered): the Pathlynks pool user may hold write privileges (pathlynksadm). Exactly "1" skips the connect-time write-privilege refusal; default off. SELECT-only SQL and a read-only transaction stay enforced either way, and a startup warning event names the override.
PATHLYNKS_ALLOW_PRIVILEGED_ROLE=
# Optional: per-call timeout for the Pathlynks tools in ms. Unset = 3000.
VC_PATHLYNKS_TIMEOUT_MS=
