    assert summary["occupied_wall_seconds"] == 2
    assert summary["corroborated_wait_seconds"] == 1
    assert summary["agent_active_seconds"] == 1


def test_delivery_cli_opt_in_preserves_default_shape_and_scopes_queries(tmp_path, monkeypatch, capsys):
    path = tmp_path / "root.jsonl"
    _write(str(path), [_event("root", "a", 1)])
    ledger = tmp_path / "bindings.json"
    ledger.write_text(json.dumps({"coverage_complete": True, "bindings": [_binding("root", "maker", path)],
                                 "delivery": {"root_run_id": "root", "child_manifest_complete": True}}), encoding="utf-8")
    monkeypatch.setattr(token_scan, "PROJECTS", str(tmp_path / "empty"))
    argv = ["token_scan.py", "--bindings", str(ledger), "--feature", "P0", "--json"]
    monkeypatch.setattr(sys, "argv", argv)
    token_scan.main()
    legacy = json.loads(capsys.readouterr().out)
    assert "delivery_summary" not in legacy and "delivery_summary" not in legacy["feature_report"]
    assert set(legacy["feature_report"]) == {"schema_version", "rows", "efficiency", "roles", "runs",
                                            "agent_active_seconds", "wall_seconds", "wait_seconds", "overall_tokens", "timing_basis"}
    def no_sweep(*args, **kwargs):
        raise AssertionError("delivery must not sweep global sessions")
    monkeypatch.setattr(token_scan, "_transcripts", no_sweep)
    monkeypatch.setattr(token_scan, "compactions", no_sweep)
    monkeypatch.setattr(token_scan, "classifier_outages", no_sweep)
    monkeypatch.setattr(sys, "argv", argv + ["--delivery"])
    token_scan.main()
    opted = json.loads(capsys.readouterr().out)
    assert opted["delivery_summary"]["schema_version"] == 2
    assert opted["delivery_summary"]["checker_diagnostic"]["gating"] is False
    for key in ("main_tokens", "sub_tokens", "rows", "schema_version", "efficiency"):
        assert opted[key] == legacy[key]


def test_delivery_requires_finite_explicit_scope_and_valid_metadata(tmp_path, monkeypatch):
    import pytest
    with pytest.raises(ValueError, match="requires --bindings and --feature"):
        token_scan.scan(delivery=True)
    path = tmp_path / "root.jsonl"
    _write(str(path), [_event("root", "a", 1)])
    binding = _binding("root", "maker", path)
    with pytest.raises(ValueError, match="acceptance must be an array"):
        _delivery(tmp_path, monkeypatch, [binding], acceptance="broken report")
    ledger = tmp_path / "delivery.json"
    with pytest.raises(ValueError, match="not a directory sweep"):
        token_scan.scan(bindings=str(ledger), feature="P0", codex_root=str(tmp_path), delivery=True)


def _context_benchmark(client="codex"):
    baseline_usage = {"input_tokens": 100, "cached_input_tokens": 20,
                      "cache_write_input_tokens": 10, "output_tokens": 10}
    compact_usage = {"input_tokens": 60, "cached_input_tokens": 30,
                     "cache_write_input_tokens": 5, "output_tokens": 12}
    if client == "claude":
        baseline_usage = {"input_tokens": 10, "cache_read_input_tokens": 60,
                          "cache_creation_input_tokens": 30, "output_tokens": 10}
        compact_usage = {"input_tokens": 8, "cache_read_input_tokens": 40,
                         "cache_creation_input_tokens": 12, "output_tokens": 12}
    common = dict(client=client, task_id="fixed-task", model_id="fixed-model",
                  settings_id="fixed-security-and-model", oracle_id="same-acceptance-v1", accepted=True,
                  cost_basis="cli-list-estimate", agent_read_calls=4, source_verification_read_bytes=100)
    return {"schema_version": "context-benchmark/1", "setup": {"elapsed_ms": 500, "reported_cost_usd": 0.5},
            "limitations": ["Recorded fixture; not live evidence."], "runs": [
                dict(common, variant="baseline", elapsed_ms=2000, first_response_ms=200,
                     prompt_bytes=1000, reported_cost_usd=0.3, usage=baseline_usage),
                dict(common, variant="compact", elapsed_ms=1000, first_response_ms=100,
                     prompt_bytes=500, reported_cost_usd=0.1, usage=compact_usage)]}


def _context_report(tmp_path, monkeypatch, capsys, benchmark):
    path = tmp_path / "context-benchmark.json"
    path.write_text(json.dumps(benchmark), encoding="utf-8")
    monkeypatch.setattr(sys, "argv", ["token_scan.py", "--context-compare", str(path)])
    def no_sweep(*args, **kwargs):
        raise AssertionError("comparison must not scan transcripts")
    for name in ("scan", "compactions", "classifier_outages"):
        monkeypatch.setattr(token_scan, name, no_sweep)
    token_scan.main()
    return json.loads(capsys.readouterr().out)["contextComparison"]


def test_context_comparison_codex_subsets_cost_and_cli_scope(tmp_path, monkeypatch, capsys):
    report = _context_report(tmp_path, monkeypatch, capsys, _context_benchmark())
    codex = report["clients"]["codex"]
    metrics = codex["metrics"]
    assert metrics["input_total_tokens"]["baseline"] == 100  # inclusive, not 130
    assert metrics["input_total_tokens"]["saved"] == 40
    assert metrics["noncached_input_tokens"]["saved"] == 45
    assert metrics["cache_read_input_tokens"]["saved"] == -10
    assert metrics["output_tokens"]["status"] == "REGRESSION"
    assert metrics["prompt_bytes"]["saved_percent"] == 50
    assert codex["speedup"] == 2 and codex["break_even_runs"] == 3
    assert abs(codex["experiment_cost_usd"] - 0.4) < 1e-9
    assert codex["account_bill_savings_usd"] is None
    assert report["setup"]["reported_cost_usd"] == 0.5
    assert any("not a causal estimate" in text for text in report["limitations"])


def test_context_comparison_claude_additional_cache_channels(tmp_path, monkeypatch, capsys):
    report = _context_report(tmp_path, monkeypatch, capsys, _context_benchmark("claude"))
    metrics = report["clients"]["claude"]["metrics"]
    assert metrics["input_total_tokens"]["baseline"] == 100
    assert metrics["input_total_tokens"]["compact"] == 60
    assert metrics["noncached_input_tokens"]["baseline"] == 10
    assert metrics["cache_write_input_tokens"]["saved"] == 18


def test_context_comparison_missing_metrics_are_unknown(tmp_path, monkeypatch, capsys):
    benchmark = _context_benchmark("claude")
    benchmark["runs"][1]["usage"].pop("cache_creation_input_tokens")
    for key in ("reported_cost_usd", "agent_read_calls", "source_verification_read_bytes", "first_response_ms"):
        benchmark["runs"][1].pop(key)
    benchmark["setup"] = {}
    report = _context_report(tmp_path, monkeypatch, capsys, benchmark)
    client = report["clients"]["claude"]
    for key in ("input_total_tokens", "cache_write_input_tokens", "reported_cost_usd", "agent_read_calls",
                "source_verification_read_bytes", "first_response_ms"):
        assert client["metrics"][key]["compact"] is None
        assert client["metrics"][key]["status"] == "UNKNOWN"
        assert client["metrics"][key]["saved"] is None
    assert client["break_even_runs"] is client["experiment_cost_usd"] is None
    assert report["setup"] == {"elapsed_ms": None, "reported_cost_usd": None}


def test_context_comparison_mismatched_oracle_rejected(tmp_path, monkeypatch, capsys):
    import pytest
    benchmark = _context_benchmark()
    benchmark["runs"][1]["oracle_id"] = "easier-oracle"
    with pytest.raises(SystemExit) as error:
        _context_report(tmp_path, monkeypatch, capsys, benchmark)
    assert error.value.code == 2
    assert "pair task/model/settings/oracle must match" in capsys.readouterr().err


def test_context_comparison_nonaccepted_and_duplicate_runs_rejected(tmp_path, monkeypatch, capsys):
    import pytest
    for invalid in ("nonaccepted", "duplicate", "missing-pair"):
        benchmark = _context_benchmark()
        if invalid == "nonaccepted":
            benchmark["runs"][1]["accepted"] = False
        elif invalid == "duplicate":
            benchmark["runs"].append(dict(benchmark["runs"][0]))
        else:
            benchmark["runs"].pop()
        with pytest.raises(SystemExit) as error:
            _context_report(tmp_path, monkeypatch, capsys, benchmark)
        assert error.value.code == 2


def test_context_comparison_invalid_numbers_and_provider_channels_rejected(tmp_path, monkeypatch, capsys):
    import pytest
    for key, value in (("input_tokens", True), ("cached_input_tokens", 101),
                       ("cache_write_input_tokens", 101), ("output_tokens", -1),
                       ("cache_creation_input_tokens", 0), ("input_tokens", float("nan"))):
        benchmark = _context_benchmark()
        benchmark["runs"][0]["usage"][key] = value
        with pytest.raises(SystemExit) as error:
            _context_report(tmp_path, monkeypatch, capsys, benchmark)
        assert error.value.code == 2
    benchmark = _context_benchmark()
    benchmark["runs"][0]["prompt_bytes"] = 1.5
    with pytest.raises(SystemExit):
        _context_report(tmp_path, monkeypatch, capsys, benchmark)
    benchmark = _context_benchmark()
    benchmark["runs"][0]["usage"].update(cached_input_tokens=60, cache_write_input_tokens=50)
    with pytest.raises(SystemExit):
        _context_report(tmp_path, monkeypatch, capsys, benchmark)


def test_context_comparison_mixed_cost_bases_never_claim_bill_savings(tmp_path, monkeypatch, capsys):
    benchmark = _context_benchmark()
    benchmark["runs"][1]["cost_basis"] = "account-bill"
    client = _context_report(tmp_path, monkeypatch, capsys, benchmark)["clients"]["codex"]
    cost = client["metrics"]["reported_cost_usd"]
    assert cost["baseline"] == 0.3 and cost["compact"] == 0.1
    assert cost["status"] == "UNKNOWN" and cost["saved"] is None
    assert client["account_bill_savings_usd"] is client["experiment_cost_usd"] is client["break_even_runs"] is None


def test_context_comparison_both_clients_and_regression_no_speedup(tmp_path, monkeypatch, capsys):
    benchmark = _context_benchmark()
    benchmark["runs"][1].update(elapsed_ms=3000, reported_cost_usd=0.4)
    benchmark["runs"] += _context_benchmark("claude")["runs"]
    for run in benchmark["runs"]:
        run["cost_basis"] = "account-bill"
    clients = _context_report(tmp_path, monkeypatch, capsys, benchmark)["clients"]
    assert set(clients) == {"codex", "claude"}
    assert clients["codex"]["metrics"]["elapsed_ms"]["saved"] == -1000
    assert clients["codex"]["metrics"]["elapsed_ms"]["status"] == "REGRESSION"
    assert clients["codex"]["speedup"] is clients["codex"]["break_even_runs"] is None
    assert abs(clients["claude"]["account_bill_savings_usd"] - 0.2) < 1e-9


def test_native_thread_identity_survives_parent_session_and_duplicate_mirror(tmp_path, monkeypatch):
    parent, child = tmp_path / "parent.jsonl", tmp_path / "child.jsonl"
    def task(kind, turn, second):
        return {"type": "event_msg", "timestamp": TODAY + "T10:00:%02dZ" % second,
                "payload": {"type": kind, "turn_id": turn}}
    def usage(thread, turn, response, second, tokens):
        return {"type": "token_usage_record", "timestamp": TODAY + "T10:00:%02dZ" % second,
                "payload": {"session_id": "parent", "thread_id": thread, "turn_id": turn,
                            "response_id": response, "usage": {"input_tokens": tokens, "output_tokens": 0}}}
    mirrored = usage("child", "ct", "child-response", 6, 10)
    _write(str(parent), [{"type": "session_meta", "payload": {"id": "parent"}},
                         task("task_started", "pt", 0), mirrored,
                         usage("parent", "pt", "parent-response", 10, 100),
                         task("task_complete", "pt", 20)])
    _write(str(child), [{"type": "session_meta", "payload": {"id": "child"}},
                        task("task_started", "ct", 5), mirrored,
                        task("task_complete", "ct", 7)])
    result = _report(tmp_path, monkeypatch, [_binding("parent", "maker", parent, turn_id="pt"),
                                           _binding("child", "checker", child, turn_id="ct")])
    actual = {x["run_id"]: x for x in result["runs"]}
    assert actual["parent"]["active_seconds"] == 20
    assert actual["child"]["active_seconds"] == 2
    assert actual["parent"]["tokens"] == 100
    assert actual["child"]["tokens"] == 10  # mirrored native response counts once
    assert result["efficiency"]["complete"]
    assert result["efficiency"]["time_ratio"] == result["efficiency"]["token_ratio"] == 0.1
