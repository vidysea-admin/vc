{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/app/(admin)/(assissmentManagement)/view-this-assessment/page.jsx",
    "src/app/(full-width-pages)/(auth)/update-school/page.jsx",
    "src/interceptors/http.js",
    "src/services/authService.js",
    "src/services/utilService.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
