# =====================================================================================================================
# Virtual Counsellor API (@vc/api) on Google Cloud Run: environment variables (NAMES ONLY, no values)
#
# For: Cogniv SRE (ticket #2129). Deploy the repo's root Dockerfile as a Cloud Run service in asia-south1, like the
# KnowledgeBase (https://vidysea-knowledgebase-358281750133.asia-south1.run.app).
#
#  - [SECRET]  -> create in GCP Secret Manager and expose to the service as an env var of the same name.
#                 Vidysea (Umesh) supplies every secret value over a private channel. Never by email or ticket.
#  - [PLAIN]   -> set as a normal Cloud Run env var. Where a value is shown below, use it as is.
#  - Empty     -> leave unset unless Vidysea gives a value. Unset is safe: features stay off, defaults apply.
#  - Do NOT set PORT (Cloud Run sets it) or VC_API_PORT (the container maps PORT onto it).
#  - The image already sets VC_BIND_HOST=0.0.0.0 and VC_CLIENT_IP_SOURCE=cloud-run.
#
# NETWORK (needed before the first start):
#  - MongoDB is IP-allow-listed. Cloud Run has no fixed outbound IP by default: please route egress through a
#    Serverless VPC Access connector + Cloud NAT with a reserved static IP, and send us that IP so it can be allow-listed
#    on the Mongo server. The API uses only the database "virtual_counsellor".
#  - The service must be publicly reachable over HTTPS (allow unauthenticated invocations; the API does its own auth).
#  - Health checks: liveness GET /health -> 200 {"status":"ok"}; readiness GET /ready (pings Mongo).
#  - Min instances 1 is recommended (the monthly LLM spend cap is kept in memory).
#
# FIRST RELEASE (M1) = text only: the anonymous student route ON; authenticated chat, voice, partner keys, admin OFF.
# =====================================================================================================================

# ---------- Core (required for M1) ----------
# [SECRET] MongoDB connection string for the virtual_counsellor database.
MONGODB_URL=
# [PLAIN] Go-live approver name; the API refuses to start a surface without the signed gate record carrying it.
VC_GATE_APPROVER=Umesh
# [PLAIN] Surfaces. Exactly "true" turns one on.
VC_ANONYMOUS_ENABLED=true
VC_CHAT_ENABLED=false
VC_VOICE_ENABLED=false

# ---------- Model provider (required for M1) ----------
# [PLAIN] REQUIRED (the API refuses to start without it). Vidysea decides: "gemini" (Google Gemini) or "litellm"
# (Ollama Cloud via the OpenAI-compatible seam).
VC_LLM_PROVIDER=
# [PLAIN] Model id for the chosen provider (Vidysea supplies).
VC_LLM_MODEL=
# [SECRET] Needed when VC_LLM_PROVIDER=gemini, or for grounding/voice.
GEMINI_API_KEY=
# [PLAIN] Needed only when VC_LLM_PROVIDER=litellm (e.g. https://ollama.com/v1).
VC_LLM_BASE_URL=
# [SECRET] Needed only when VC_LLM_PROVIDER=litellm.
VC_LLM_API_KEY=
# [PLAIN] Optional per-role model overrides (fall back to VC_LLM_MODEL).
VC_MODEL_SUMMARY=
VC_MODEL_ANSWER=
VC_MODEL_ROUTER=
# [PLAIN] Optional concern classifier model (default flash-lite) and timeout ms.
VC_CONCERN_MODEL=
VC_CONCERN_TIMEOUT_MS=
VC_CONCERN_SAMPLE_RATES=

# ---------- Student text chain (optional; only if Vidysea chooses Ollama for student replies) ----------
# [PLAIN] e.g. ollama:deepseek-v4.1-flash,ollama:glm-5.3-flash
VC_TEXT_CHAIN=
# [SECRET] Required when VC_TEXT_CHAIN is set.
OLLAMA_API_KEY=
# [PLAIN] REQUIRED when VC_TEXT_CHAIN is set: monthly USD cap (Vidysea supplies the number).
VC_CHAIN_MONTHLY_CAP_USD=
VC_TEXT_CHAIN_HOP_TIMEOUT_MS=
VC_TEXT_CHAIN_DEADLINE_MS=
OLLAMA_BASE_URL=
OLLAMA_MAX_OUTPUT_TOKENS=
OLLAMA_PRICE_USD_PER_MTOK=

# ---------- KnowledgeBase (required for M1) ----------
# [PLAIN]
VC_KB_BASE_URL=https://vidysea-knowledgebase-358281750133.asia-south1.run.app
# [SECRET] Search-only key for the anonymous route (never the chat key).
VC_KB_ANON_API_KEY=
# [SECRET] Needed only when VC_CHAT_ENABLED=true.
VC_KB_API_KEY=
# [PLAIN] Optional tuning.
VC_KB_TIMEOUT_MS=
VC_KB_BREAKER_FAILS=
VC_KB_BREAKER_COOLDOWN_MS=
VC_KB_ROUTE=
# [PLAIN] Leave unset on Cloud Run (no speakers file yet).
VC_SPEAKERS_FILE=

# ---------- Counsellor API JWT (REQUIRED even for M1: the API refuses to start without it; Vidysea supplies) ----------
# [PLAIN] issuer, audience, algorithms are required.
VC_JWT_ISSUER=
VC_JWT_AUDIENCE=
VC_JWT_ALGORITHMS=
VC_JWT_CLOCK_SKEW_SEC=
# Exactly one key source: [PLAIN] public key or JWKS URL, or [SECRET] HS256 secret.
VC_JWT_PUBLIC_KEY=
VC_JWT_JWKS_URL=
VC_JWT_HS256_SECRET=

# ---------- Student JWT (only when VC_CHAT_ENABLED or VC_VOICE_ENABLED is true; not M1) ----------
VC_STUDENT_JWT_ISSUER=
VC_STUDENT_JWT_AUDIENCE=
VC_STUDENT_JWT_ALGORITHMS=
VC_STUDENT_JWT_PUBLIC_KEY=
VC_STUDENT_JWT_JWKS_URL=
# [SECRET]
VC_STUDENT_JWT_HS256_SECRET=
VC_STUDENT_JWT_CLOCK_SKEW_SEC=
VC_STUDENT_JWT_CLAIM_TENANT=
VC_STUDENT_JWT_CLAIM_STUDENT_ID=
VC_STUDENT_JWT_CLAIM_ROLE=
VC_STUDENT_JWT_CLAIM_IS_MINOR=
VC_STUDENT_JWT_CLAIM_AGE=
VC_STUDENT_JWT_CLAIM_GUARDIAN_CONSENT=
VC_TURN_DEADLINE_MS=
VC_REPLY_LANGS=

# ---------- Safety / privacy ----------
# [PLAIN] Optional, exactly "true" turns on the model safety screen on the anonymous route.
VC_ANONYMOUS_SAFETY_SCREEN=
# [SECRET] >= 32 chars; required for the erasure routes.
VC_AUDIT_HMAC_KEY=
# [PLAIN]
VC_ERASURE_APPROVER_EMAIL=
VC_ERASURE_AUTO_DELETE=

# ---------- Web grounding (optional; general questions only, never student data) ----------
VC_GROUNDING=
VC_GROUNDING_MODEL=
VC_GROUNDING_MAX_PER_SESSION=
VC_GROUNDING_MAX_PER_DAY=

# ---------- Voice (not M1; keep VC_VOICE_ENABLED=false) ----------
VC_VOICE_MODEL=
# [SECRET] >= 32 bytes.
VC_VOICE_WS_SECRET=
# [PLAIN] wss://<this service's public host>
VC_VOICE_WS_BASE_URL=

# ---------- Partner keys and admin console (not M1) ----------
# [SECRET]
VC_PARTNER_KEY_PEPPER=
VC_PARTNER_KEY_REQUIRED=
VC_RESERVED_TENANT_IDS=
VC_PARTNER_OWN_TENANTS=
# [SECRET] base64 of exactly 32 random bytes.
VC_ADMIN_MASTER_KEY=
# [SECRET] >= 32 chars.
VC_ADMIN_JWT_SECRET=
VC_USD_INR_RATE=

# ---------- Webhooks (optional) ----------
# [SECRET]
VC_WEBHOOK_SECRET=
VC_WEBHOOK_DESTINATION_URL=

# ---------- Pathlynks / Vidysea read-only data (not M1) ----------
# [SECRET]
PATHLYNKS_DB_PASSWORD=
PATHLYNKS_DB_CA_FILE=
PATHLYNKS_ALLOW_PRIVILEGED_ROLE=
VC_PATHLYNKS_TIMEOUT_MS=
# [SECRET]
VIDYSEA_DB_PASSWORD=
VIDYSEA_DB_CA_FILE=
VIDYSEA_ALLOW_PRIVILEGED_ROLE=
# [SECRET] optional
GITHUB_TOKEN=

# ---------- Observability (optional) ----------
GEMINI_PRICE_USD_PER_MTOK=
MONGO_CLIENT_TIMEOUT_MS=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
# [SECRET]
LANGFUSE_SECRET_KEY=

# ---------- litellm failover (optional, litellm only) ----------
VC_LLM_MODELS=
VC_LLM_RETRY_BUDGET=
VC_LLM_DEADLINE_MS=
VC_LLM_ATTEMPT_TIMEOUT_MS=

# NEVER set: LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING, LANGCHAIN_TRACING_V2
# (if any is "true", the student surfaces refuse to start: no student text is ever traced).
